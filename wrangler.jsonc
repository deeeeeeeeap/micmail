{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micmail",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "MAIL_RETENTION_DAYS": "90",
    "SESSION_TTL_HOURS": "12",
    // Free-plan friendly defaults: each Worker invocation only has ~50 subrequests
    // (Graph fetches + D1 queries + R2 ops all count). Raise these on a paid plan.
    "SYNC_PAGE_SIZE": "20",
    "MAX_SYNC_PAGES": "40",
    "SYNC_OPS_BUDGET": "35",
    "SYNC_CONCURRENCY": "1",
    "SYNC_FOLDERS": "inbox,junkemail",
    "AUTO_SYNC_STALE_MINUTES": "30",
    "TRANSIENT_RETRY_MINUTES": "10",
    "MAX_SYNC_ACCOUNTS_PER_RUN": "3",
    "SYNC_RUN_RETENTION_DAYS": "14",
    // Set to the public origin of this Worker (e.g. "https://micmail.example.workers.dev")
    // to enable cron fan-out: each account syncs in its own invocation with a fresh
    // subrequest budget. With fan-out enabled MAX_SYNC_ACCOUNTS_PER_RUN can be raised.
    "PUBLIC_BASE_URL": "",
    "IMAP_FETCH_BATCH_SIZE": "1",
    "IMAP_BODY_PEEK_BYTES": "2097152",
    "IMAP_COMMAND_TIMEOUT_SECONDS": "60",
    "IMAP_IDLE_TIMEOUT_SECONDS": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micmail",
      "database_id": "eeb9e204-432e-4394-b9a6-0a5efc521bc0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "micmail"
    }
  ]
}
